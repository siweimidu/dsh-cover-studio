{
  "name": "dsh-cover-studio",
  "version": "1.0.0",
  "description": "AI 日报封面工作台 — DeepSeek Harness 全页插件 + CLI：171 个 AI 模型图标、无限画布拖拽编辑、打散排布、像素级对齐 Skill 版式，所有功能可在命令行与 Agent 工具中调用",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cli": "./lib/cli.js",
    "./shared/layout": "./lib/shared/layout.js",
    "./shared/scene": "./lib/shared/scene.js",
    "./shared/render": "./lib/shared/render.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "src/client/engine.js",
    "src/client/skill-bridge.js",
    "templates/**/*.html",
    "docs/**/*.png",
    "docs/**/*.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-daily",
    "cover-editor",
    "canvas-editor",
    "tts",
    "hyperframes"
  ],
  "author": "",
  "homepage": "https://github.com/siweimidu/dsh-cover-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siweimidu/dsh-cover-studio.git"
  },
  "bugs": {
    "url": "https://github.com/siweimidu/dsh-cover-studio/issues"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/cli.js && node --check lib/shared/layout.js && node --check lib/shared/scene.js && node --check lib/shared/render.js",
    "cli": "node lib/cli.js",
    "doctor": "node lib/cli.js doctor"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cover-studio": "./lib/cli.js"
  }
}
